APP_NAME="MHCS Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# MHCS security keys are required secret-managed values; names only are committed here.
MHCS_IDENTIFIER_KEY=
MHCS_OBJECT_ENCRYPTION_KEY=
MHCS_ACCESS_GRANT_KEY=
MHCS_MANIFEST_KEY=
MHCS_MANIFEST_KEY_ID=

# Verification-asset grants are fail-closed outside local/test defaults.
# MHCS_ASSET_GRANT_MAX_TTL_SECONDS=300
# MHCS_ASSET_GRANT_AUDIENCES=member-view

# Credential throttling: safe local-development defaults only; production values require approval and injection.
# MHCS_LOGIN_PAIR_MAX_ATTEMPTS=5
# MHCS_LOGIN_ORIGIN_MAX_ATTEMPTS=10
# MHCS_LOGIN_IDENTIFIER_MAX_ATTEMPTS=20
# MHCS_LOGIN_DECAY_SECONDS=60

# Fail-closed untrusted image policy; production values require measured approval.
MHCS_IMAGE_FILE_COUNT=
MHCS_IMAGE_PER_FILE_BYTES=
MHCS_IMAGE_TOTAL_BYTES=
MHCS_IMAGE_DECOMPRESSED_BYTES=
MHCS_IMAGE_MAX_WIDTH=
MHCS_IMAGE_MAX_HEIGHT=
MHCS_IMAGE_FIELD_COUNT=
MHCS_IMAGE_CPU_SECONDS=
MHCS_IMAGE_MEMORY_BYTES=
MHCS_IMAGE_EXECUTION_SECONDS=
MHCS_IMAGE_PROCESS_COUNT=
MHCS_IMAGE_TEMPORARY_STORAGE_BYTES=
MHCS_IMAGE_ACCEPTED_FORMS=
MHCS_IMAGE_RECOVERY_WINDOW_SECONDS=
MHCS_IMAGE_MAX_ATTEMPTS=

# Image-worker container controls; deployment-injected values are required and have no defaults.
MHCS_IMAGE_WORKER_CPU_LIMIT=
MHCS_IMAGE_WORKER_MEMORY_LIMIT=
MHCS_IMAGE_WORKER_PIDS_LIMIT=
MHCS_IMAGE_WORKER_EXECUTION_TIMEOUT_SECONDS=
MHCS_IMAGE_WORKER_TMPFS_SIZE=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local application development and deployment use MySQL 8.4.
# Fill DB_PASSWORD and DB_ROOT_PASSWORD locally; neither is committed here.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mhcs_core
DB_USERNAME=mhcs_local
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Fast automated tests intentionally override this with SQLite :memory:.
# Database-sensitive verification uses an isolated mysql:8.4 container.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
